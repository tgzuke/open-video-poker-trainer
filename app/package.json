{
  "name": "open-video-poker-trainer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../engine --target web --out-dir ../app/src/wasm --release --no-pack",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:wasm && vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
